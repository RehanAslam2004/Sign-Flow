# SignFlow Environment Variables

# WebSocket URL for the Python FastAPI Computer Vision Inference Service
# Local development default:
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8000/ws/predict

# Production Render deployment example:
# Replace with the URL of your deployed Python CV service on Render:
# NEXT_PUBLIC_WS_URL=wss://signflow-cv.onrender.com/ws/predict
