# SignFlow CV Service - Environment Configuration Template
# Keep this file sanitized (do NOT commit secrets)

# Google Gemini API key (obtain from Google AI Studio / Cloud Console)
GEMINI_API_KEY=your_gemini_api_key_here

# Default Gemini Model (gemini-flash-lite-latest is recommended for high throughput & zero capacity spikes)
GEMINI_MODEL=gemini-flash-lite-latest

# Temporal sliding window duration in seconds
TEMPORAL_WINDOW_SECONDS=2.0

# Frame sampling rate for temporal signing analysis (FPS)
TARGET_FRAME_RATE=5

# Maximum concurrent Gemini API requests to prevent quota congestion
MAX_CONCURRENT_GEMINI_REQUESTS=2
